
# Domain URL (Production deployment domain for SEO, robots.txt, sitemap.xml, metadataBase)
NEXT_PUBLIC_SITE_URL=https://mphim.site

# TMDB Service Token (Server-side proxy for credits, backdrop images)
TMDB_API_TOKEN=your_tmdb_api_read_access_token_here

# Supabase Configuration (Watch History Online Sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
